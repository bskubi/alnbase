forward:reverse/+-	147	chr1	101	60	4M	=	301	-200	ACGT	IIII	ZS:Z:+-
reverse:reverse/-+	83	chr1	101	60	4M	=	301	-200	ACGT	IIII	ZS:Z:-+
reverse:forward/--	163	chr1	101	60	4M	=	301	200	ACGT	IIII	ZS:Z:--
