@HD	VN:1.6	SO:unsorted
@SQ	SN:chr1	LN:1000
@CO	Records for query/strand/astair.toml
@CO	query/strand/astair.toml -- asTair's own table of six FLAG integers, plus the unknown arm
@CO	that makes it total. FLAG 65 is what bwa gave the not-proper pair in
@CO	alnbase-validation/demos/astair-strand; without the arm the run aborts on it.
@CO	Each QNAME is the call the rule must make for that record: "<original>:<aligned>",
@CO	each side forward or reverse, or "unknown". Anything after the first "/" is a label
@CO	for the reader. The test that enforces it is in src/strand_rule.rs.
forward:forward/99	99	chr1	101	60	4M	=	301	200	ACGT	IIII
forward:reverse/147	147	chr1	101	60	4M	=	301	-200	ACGT	IIII
reverse:reverse/83	83	chr1	101	60	4M	=	301	-200	ACGT	IIII
reverse:forward/163	163	chr1	101	60	4M	=	301	200	ACGT	IIII
forward:forward/0	0	chr1	101	60	4M	*	0	0	ACGT	IIII
reverse:reverse/16	16	chr1	101	60	4M	*	0	0	ACGT	IIII
unknown/65	65	chr1	101	60	4M	=	241	141	ACGT	IIII
